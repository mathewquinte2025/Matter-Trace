# --- Python environment and caches ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# --- Local runtime data (never commit) ---
# data/ holds the SQLite database and the stored copies of every uploaded document.
# It is regenerated by running the app or `python -m mattertrace.seed --reset`.
data/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
uploads/
originals/
*.log

# --- Secrets and credentials ---
.env
.env.*
!.env.example
.streamlit/secrets.toml
credentials.json
*.pem
*.key

# --- OS / editor clutter ---
Thumbs.db
desktop.ini
.DS_Store
